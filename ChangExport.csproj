<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <AssemblyName>ChangExport</AssemblyName>
    <RootNamespace>ChangExport</RootNamespace>
    <AssemblyTitle>창Export</AssemblyTitle>
    <Product>창Export</Product>
    <Description>한국형 Revit DWG Export 도구</Description>
    <Company>LAON ArcTec</Company>
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="AutoCadBridge\ChangExport.AutoCadBridge.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <EmbeddedResource Include="AutoCadBridge\bin\$(Configuration)\net48\ChangExport.AutoCadBridge.dll" LogicalName="ChangExport.AutoCadBridge.dll" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AutoCadBridge\**\*.cs;Tests\**\*.cs" />
    <Content Include="Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
