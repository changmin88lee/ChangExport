<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <AssemblyName>ChangExport</AssemblyName>
    <RootNamespace>ChangExport</RootNamespace>
    <AssemblyTitle>창Export</AssemblyTitle>
    <Product>창Export</Product>
    <Description>한국형 Revit DWG Export 도구</Description>
    <Company>LAON ArcTec</Company>
    <Version>0.15.2</Version>
    <FileVersion>0.15.2.0</FileVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2026</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.7.1" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="runtime" />
    <EmbeddedResource Include="$(PkgACadSharp)\lib\net8.0\ACadSharp.dll" LogicalName="ChangExport.Dependencies.ACadSharp.dll" />
    <EmbeddedResource Include="ThirdParty\*.txt" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs;**\obj\**\*.cs;**\bin\**\*.cs" />
  </ItemGroup>

</Project>
