<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ChangExport.AutoCadBridge</AssemblyName>
    <AutoCADDirectory Condition="'$(AutoCADDirectory)' == ''">C:\Program Files\Autodesk\AutoCAD 2023</AutoCADDirectory>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="accoremgd"><HintPath>$(AutoCADDirectory)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AutoCADDirectory)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcExportLayout"><HintPath>$(AutoCADDirectory)\AcExportLayout.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Drawing" />
    <Compile Include="..\DwgProcessing\BridgeContract.cs" Link="BridgeContract.cs" />
  </ItemGroup>
</Project>
